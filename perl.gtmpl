---
[switches]
header = add basic header
---
#!/usr/bin/perl
{{ if .Enabled "header" }}
#===============================================================================
#
#         FILE:  {{.ScriptName}}
#
#        USAGE:  {{.Description}}
#
#  DESCRIPTION:  {{.Description}}
#
#      OPTIONS:  ---
# REQUIREMENTS:  ---
#         BUGS:  ---
#        NOTES:  ---
#       AUTHOR:  {{.User}} ({{.UserName}}), {{.MailAddress}}
#      COMPANY:  {{.Company}}
#      CREATED:  {{.Date}}
#===============================================================================
{{ end }}
use strict;
use warnings;


{{ if .Enabled "header" }}
#===============================================================================
# MAIN
#===============================================================================
{{ end }}


{{ if .Enabled "header" }}
#===============================================================================
# END
#===============================================================================
{{ end }}
__END__
